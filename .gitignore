# originales de fotos: se procesan a assets/img/, no se versionan
/Fotos/
/Página/

# originales de camara: nunca al repo, en ninguna carpeta
*.heic
*.HEIC
*.mp4
*.mov
*.MOV

# excepcion: video web ya procesado
!assets/video/*.mp4

# en assets/img solo entran los webp procesados
assets/img/*
!assets/img/*.webp

# material de trabajo del pipeline de imagenes, no se versiona
/assets/img/manifest.json

# material de trabajo de la auditoria de fotos
Fotos/_laminas/
